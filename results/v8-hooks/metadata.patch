+fn known_child(id: TypeId, schema: &Schema) -> Option<String> {
+    match &schema.types[id] {
+        AstType::Option(opt) => known_child(opt.inner_type_id, schema),
+        AstType::SubRange(range) => known_child(range.inner_type_id, schema),
+        AstType::Struct(ast) => Some(match ast.name.as_str() {
